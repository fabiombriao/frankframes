# Fim de linha: LF no índice e na árvore de trabalho, em qualquer máquina.
# Sobrepõe o core.autocrlf do gitconfig do sistema (no Windows ele vem ligado).
* text=auto eol=lf

# Binários: nunca converter fim de linha nem mostrar diff de texto.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.mov binary
*.webm binary
*.wav binary
*.mp3 binary
*.woff2 binary
*.woff binary
*.ttf binary
*.otf binary
